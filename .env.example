# Copy this file to .env.local and fill in your real values.
#   cp .env.example .env.local
#
# .env.local is git-ignored (see .gitignore: .env.* is never committed).
# `./run-demo.sh ui` sources it automatically, so you don't have to export
# anything by hand. NEVER commit real tokens.

# Slack (all optional — leave unset to run the UI standalone, no Slack).
# From https://api.slack.com/apps → your app:
#   Bot User OAuth Token (OAuth & Permissions) — starts xoxb-
export SLACK_BOT_TOKEN=
#   Signing Secret (Basic Information → App Credentials)
export SLACK_SIGNING_SECRET=
#   Channel ID the bot was invited to (click the channel name → Channel ID),
#   starts with C… — where UI-triggered incidents are posted.
export SLACK_CHANNEL=
#   Optional: bind Slack users to demo principals (the approver must differ
#   from the proposer sam-oncall; unmapped users act as riley-lead).
# export SLACK_USER_MAP=U0YOURID:riley-lead

# Port the Control Tower UI listens on (default 4000).
# export PORT=4000

# ngrok auth token — only needed for real Slack buttons (the public tunnel).
# ngrok reads NGROK_AUTHTOKEN from the environment automatically, and
# `./run-demo.sh ui` sources this file before starting the tunnel.
# Get it at https://dashboard.ngrok.com/get-started/your-authtoken
# export NGROK_AUTHTOKEN=
