{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI-EOS Audit Log Entry",
  "type": "object",
  "required": [
    "entry_id",
    "prev_hash",
    "timestamp",
    "actor",
    "action"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "format": "uuid"
    },
    "prev_hash": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "required": [
        "id",
        "role",
        "org_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "engineer",
            "lead",
            "manager",
            "executive",
            "system",
            "admin"
          ]
        },
        "org_id": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "string",
      "enum": [
        "PIPELINE_TRIGGER",
        "PIPELINE_PAUSE",
        "PIPELINE_HALT",
        "PIPELINE_RESUME",
        "PIPELINE_COMPLETE",
        "HIL_APPROVE",
        "HIL_REVISE",
        "HIL_SKIP",
        "HIL_PAUSE",
        "HIL_HALT",
        "AGENT_INVOKED",
        "AGENT_COMPLETE",
        "AGENT_FAILED",
        "AGENT_RETRY",
        "MODEL_FALLBACK",
        "BUDGET_ALERT",
        "BUDGET_EXCEEDED",
        "POLICY_ALLOW",
        "POLICY_DENY",
        "POLICY_WARN",
        "PII_REDACTED",
        "RBAC_GRANT",
        "RBAC_DENY",
        "PROMPT_VERSION_CHANGE",
        "INITIATIVE_ONBOARDED",
        "SELF_HEAL_TRIGGERED",
        "SELF_HEAL_SUCCESS",
        "SELF_HEAL_EXHAUSTED"
      ]
    },
    "initiative_id": {
      "type": "string"
    },
    "story_id": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "prompt_hash": {
      "type": "string"
    },
    "response_hash": {
      "type": "string"
    },
    "tokens_consumed": {
      "type": "integer"
    },
    "cost_usd": {
      "type": "number"
    },
    "policy_result": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "WARN"
      ]
    },
    "org_signature": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    }
  }
}